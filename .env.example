# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   Windows      copy .env.example .env
#   macOS/Linux  cp .env.example .env
#
# .env 는 .gitignore 에 잡혀 있어 커밋되지 않습니다. 절대 키를 코드에 직접 쓰지 마세요.
# 값에 따옴표를 붙이지 않습니다.  ANTHROPIC_API_KEY=sk-ant-...   (O)
#                                ANTHROPIC_API_KEY="sk-ant-..." (X, 붙여도 벗겨내긴 함)

# ── Claude API ────────────────────────────────────────────────
# platform.claude.com → Settings → API Keys → Create Key
# sk-ant- 로 시작합니다.
ANTHROPIC_API_KEY=sk-ant-여기에_붙여넣기

# 주의: 콘솔에서 키에 붙인 '이름'(예: sunic-demo)이 아니라 **모델 ID** 를 씁니다.
#   claude-sonnet-5  — 데모 권장. 저비용, 문서 요약·근거 인용에 충분
#   claude-opus-5    — 더 복잡한 판단이 필요할 때
# 비워 두면 코드 기본값(claude-sonnet-5)이 쓰입니다.
ANTHROPIC_MODEL=claude-sonnet-5

# ── 네이버 뉴스 검색 (선택) ───────────────────────────────────
# developers.naver.com 에서 애플리케이션 등록 → 검색 API 사용 신청
# 없으면 구글 뉴스 RSS 로 자동 폴백합니다.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
