# 환경변수 예시 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   Windows: copy .env.example .env      macOS/Linux: cp .env.example .env
# .env 는 git 에 올라가지 않습니다. 키를 이 파일에 직접 적지 마세요.

# ── 외부 LLM (선택) ───────────────────────────────────────
# 모델과 키 두 개만 채우면 됩니다. 호출 주소는 모델 이름으로 자동 판별합니다.
#   claude-* → https://api.anthropic.com/v1/messages
#   gpt-*    → https://api.openai.com/v1/chat/completions
# 둘 중 하나라도 비면 TF-IDF + 규칙 기반 오프라인 응답으로 동작합니다.
LLM_MODEL=claude-opus-5
LLM_API_KEY=sk-ant-...

# 사내/로컬 LLM 서버(OpenAI 호환)를 쓸 때만 채웁니다. 보통 비워 둡니다.
LLM_API_URL=

# ── 서버 (선택) ───────────────────────────────────────────
# 로컬 실행 포트. 비워 두면 8020 을 씁니다.
# Render 등 호스팅에서는 플랫폼이 PORT 를 주입하므로 설정하지 마세요.
PORT=8020
