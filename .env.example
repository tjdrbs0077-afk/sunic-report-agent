# 환경변수 예시 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env 는 git 에 올라가지 않습니다. 키를 이 파일에 직접 적지 마세요.

# ── 외부 LLM (선택) ───────────────────────────────────────
# 세 값이 모두 채워졌을 때만 외부 LLM 을 호출합니다.
# 하나라도 비면 TF-IDF + 규칙 기반 오프라인 응답으로 동작합니다.
# OpenAI 호환(Chat Completions) 엔드포인트를 기대합니다.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ── 서버 (선택) ───────────────────────────────────────────
# 로컬 실행 포트. 비워 두면 8020 을 씁니다.
# Render 등 호스팅에서는 플랫폼이 PORT 를 주입하므로 설정하지 마세요.
PORT=8020
