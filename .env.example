# 이 파일을 복사해 .env 로 만들고 필요한 값을 채우세요.
#   Windows      copy .env.example .env
#   macOS/Linux  cp .env.example .env
# .env 는 Git에 올라가지 않습니다. 실제 API 키를 이 파일에 적지 마세요.

# ── Claude API (권장) ───────────────────────────────────────
# platform.claude.com → Settings → API Keys → Create Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── OpenAI 호환 API (선택) ──────────────────────────────────
# Claude 대신 OpenAI 호환 Chat Completions API를 사용할 때 설정합니다.
LLM_PROVIDER=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── 네이버 뉴스 검색 (선택) ─────────────────────────────────
# 없으면 Google 뉴스 RSS로 자동 폴백합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 서버 (선택) ─────────────────────────────────────────────
# Render 등에서는 플랫폼이 PORT를 주입하므로 설정하지 않아도 됩니다.
PORT=8120
